# 复制为本地文件（例如 loadtest.env），不要提交真实密钥和密码。
QOJ_BASE_URL=https://your-qoj.example.com
QOJ_CONTEST_ID=123
# 通常传 contest_problems.id，而不是题库 problem.id
QOJ_PROBLEM_ID=456
QOJ_ACCOUNTS_FILE=tools/contest-loadtest/accounts.csv
QOJ_CODE_FILE=tools/contest-loadtest/solution.cpp
QOJ_LANGUAGE=cpp
QOJ_USERS=100
# 将代理服务地址放在本地环境变量中；不要写进仓库或报告。
QOJ_PROXY_API_URL=https://proxy-provider.example/api/proxy?secret=REPLACE_ME
# 密码报名时才需要
QOJ_REGISTRATION_PASSWORD=
QOJ_REPORT_DIR=tools/contest-loadtest/reports
