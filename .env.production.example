# QOJ Docker 部署配置模板。
# 推荐方式：直接运行 ./deploy.sh，首次会自动生成填好随机密钥的 .env.production。
# 手动方式：复制本文件为 .env.production 并替换所有 <64位随机串>
# （可用 openssl rand -hex 32 生成）。该文件含敏感信息，已被 .gitignore 排除。

# ---- 对外入口 ----
# 前端(nginx)监听端口；80 被占用时改为其他端口（如 8080），浏览器访问地址随之变化。
QOJ_HTTP_PORT=80
# 时区，影响 MySQL 与后端日志时间。
TZ=Asia/Shanghai

# ---- Spring 环境 ----
# prod 会启用启动强校验（拒绝默认/弱 JWT 密钥）并关闭 Swagger。
SPRING_PROFILES_ACTIVE=prod
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

# ---- 数据库（首次启动自动建库建号，数据存于命名卷 qoj-mysql-data）----
MYSQL_DATABASE=qoj
MYSQL_USERNAME=qoj
MYSQL_ROOT_PASSWORD=<64位随机串>
MYSQL_PASSWORD=<64位随机串>

# ---- Redis ----
REDIS_PASSWORD=<64位随机串>

# ---- 安全密钥（生产 profile 强制要求 ≥32 位且不得含默认字样）----
JWT_SECRET=<64位随机串>
GO_JUDGE_AUTH_TOKEN=<64位随机串>

# ---- 资源上限（按宿主机规格调整；提高判题并发需同步加大内存与 CPU）----
GO_JUDGE_PARALLELISM=1
GO_JUDGE_MEM_LIMIT=2g
GO_JUDGE_CPUS=2.0
BACKEND_MEM_LIMIT=2g
MYSQL_MEM_LIMIT=1g

# ---- 可选项 ----
# 预构建镜像来源（免源码部署模式 docker-compose.prebuilt.yml 使用；源码构建模式忽略）。
# 国内直连加速示例：QOJ_IMAGE_PREFIX=ghcr.m.daocloud.io/initial3366-droid/oj
#QOJ_IMAGE_PREFIX=ghcr.io/initial3366-droid/oj
#QOJ_IMAGE_TAG=latest
# 管理后台路由与 API 前缀（两项改动后需重新构建前端镜像；compose 会将同值传给后端）。
#VITE_ADMIN_PREFIX=admin
#VITE_ADMIN_API_PREFIX=/api/admin/v1
# 国内网络加速：npm / Maven 镜像源。
#NPM_REGISTRY=https://registry.npmmirror.com
#MAVEN_MIRROR_URL=https://repo.huaweicloud.com/repository/maven
# 前后端分离部署（前端不在本机 nginx 上）时，填前端完整来源开启跨域；同源部署无需配置。
#CORS_ALLOWED_ORIGINS=https://qoj.example.com
